# Copy to .env for local Turso testing (optional — local dev works without it,
# using the .data/store.json file). NEVER commit real values.

# Your LeetCode username
LEET_USER=leegatus17

# Turso database credentials (from: turso db show / turso db tokens create)
# Leave BLANK locally to use the JSON-file store instead of Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: protects the POST /api/practice/sync endpoint (manual triggers).
# The scheduled GitHub Action does NOT use this — it writes to Turso directly.
SYNC_SECRET=
